{
  "mode": "guided",
  "engines": {
    "claude": {
      "type": "cli",
      "command": "claude -p --permission-mode acceptEdits"
    },
    "claude-readonly": {
      "type": "cli",
      "command": "claude -p --allowedTools Read Grep Glob"
    }
  },
  "roles": {
    "intake": "claude",
    "spec_check": "claude-readonly",
    "builder": "claude",
    "planner": "claude-readonly",
    "reviewer": "claude-readonly"
  },
  "verify": "python -m unittest discover",
  "limits": {
    "max_iterations": 3,
    "max_tasks": 8,
    "max_parallel": 3,
    "timeout_seconds": 900
  },
  "verify_presets": {
    "python": "python -m unittest discover",
    "node": "python \"{root}/tools/nonempty.py\" node --test"
  }
}